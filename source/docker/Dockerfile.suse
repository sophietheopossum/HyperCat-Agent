# openSUSE (zypper) build environment. --build-arg BASE=opensuse/leap:15.6 | opensuse/tumbleweed.
# Leap 15.6 ships cmake 3.20.x — right at our floor (the build fails fast if it were older). openSUSE
# Leap does NOT package cJSON dev headers, so it's deliberately omitted here: hc_json's FetchContent
# fallback (W1) fetches the pinned cJSON at configure time — a real-distro proof of the fallback.
ARG BASE=opensuse/leap:15.6
FROM ${BASE}
RUN zypper --non-interactive --gpg-auto-import-keys refresh \
    && zypper --non-interactive install -y \
         gcc gcc-c++ cmake ninja pkg-config git-core ca-certificates \
         libcurl-devel libglfw-devel openal-soft-devel libsecret-devel \
         Mesa-libGL-devel libX11-devel \
    && zypper clean -a
WORKDIR /src
COPY . /src
CMD ["bash", "docker/common/build-and-test.sh"]
