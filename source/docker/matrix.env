# The source-build coverage matrix: IMAGE|DOCKERFILE|TAGSUFFIX  (blank lines + #comments skipped).
# Driven by tools/build-matrix.sh. Add a release by adding a line; the Dockerfiles take ARG BASE.
# Images are fully-qualified (registry/namespace) so podman resolves them without short-name aliases.
# The big-4 glibc families + their key releases, plus a Tier-2 cJSON-fetch proof.

docker.io/library/ubuntu:22.04|docker/Dockerfile.debian|ubuntu2204
docker.io/library/ubuntu:24.04|docker/Dockerfile.debian|ubuntu2404
docker.io/library/debian:12|docker/Dockerfile.debian|debian12
docker.io/library/fedora:41|docker/Dockerfile.fedora|fedora41
docker.io/library/almalinux:9|docker/Dockerfile.enterprise|alma9
docker.io/library/archlinux:latest|docker/Dockerfile.arch|arch
registry.opensuse.org/opensuse/leap:15.6|docker/Dockerfile.suse|leap156

# cJSON FetchContent fallback (W1 Tier-2) — a Debian base with NO libcjson-dev:
docker.io/library/debian:12|docker/Dockerfile.nocjson|debian12-cjsonfetch
