{
  "manifest_version": 1,
  "id": "reverse-rs",
  "name": "Reverse (Rust)",
  "description": "Reverses the characters of a string. A native-runtime (Rust) example tool.",
  "author": "HyperCat Tool SDK examples",
  "version": "1.0.0",
  "runtime": { "mode": "native" },
  "tools": [
    {
      "name": "reverse",
      "spec_json": {
        "type": "function",
        "function": {
          "name": "reverse",
          "description": "Reverse the characters of a text string.",
          "parameters": {
            "type": "object",
            "properties": {
              "text": { "type": "string", "description": "The text to reverse." }
            },
            "required": ["text"]
          }
        }
      }
    }
  ],
  "permissions": { "fs": { "mode": "none" } },
  "limits": { "timeout_ms": 5000 }
}
